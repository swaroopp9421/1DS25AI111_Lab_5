#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#define MAX 100

int stack[MAX];
int top  = -1;

int main() {
    char arr[][4] = {"6","2","+","5","*","8","4","/","-"};
    int n = sizeof(arr) / sizeof(arr[0]);
    int i, A, B;
    
    for(int i = 0; i<=n; i++){
        if(isdigit(arr[i][0])){
            stack[++top]  = atoi(arr[i]);
        }
        else{
            int a  = stack[top--];
            int b = stack[top--];
            int result;
            
            switch(arr[i][0]){
                case '+':
                result = b + a;
                break;
                
                case '-':
                result = b - a;
                break;
                  
                case '*':
                result = b * a;
                break;
                  
                case '/':
                result = b/a;
                break;
                  
                case '^':
                result = pow(b,a);
                break;
            }
            stack[++top] = result;
            
        }
    }
	printf("The result is %d",stack[top--]);

}






















